":1}},"key":"jUQFoUTKmb"},{"type":"text","value":" defines the test function arguments, and then provides a list of tuples. The test runner will then call the test function with the arguments as given by each tuple in turn. Let’s see if we can achieve something similar in APL.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"X7iPyIJhh6"}],"key":"Php1moalwJ"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"This sounds like a job for an operator: we pass a ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"te8XSLuBVh"},{"type":"emphasis","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"function","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"X20RaVa6DM"}],"key":"SEW9dr7ebW"},{"type":"text","value":" to the test runner, and a vector of 3-“tuples” representing left argument, right argument and expected outcome.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"JPtGpqaly8"}],"key":"JoeJmpmYls"}],"key":"Y0w7gGfOUx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"apl","executable":true,"value":"_test←{(⊢/↑⍵)≡⍤0 0⊢⍺⍺/¯1↓⍤1⊢↑⍵}","key":"mZXfgCtTcN"},{"type":"outputs","id":"wZ8xSharx8O3JK-4z_yE0","children":[],"key":"yC7mnvxuUL"}],"key":"YqJIHL0gU4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"apl","executable":true,"value":"split _test (' ' ('hello world') ('hello' 'world')) (',' ('hello,world') ('hello' 'world'))","key":"OgZEO8XEoy"},{"type":"outputs","id":"oPFnRxtOMyYiWzi6tUGRA","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":80,"metadata":{},"data":{"text/html":{"content":"<pre class=\"language-APL\">1 1\n</pre>","content_type":"text/html"}}},"children":[],"key":"d6x9XJaoqV"}],"key":"CLwK7WXv1K"}],"key":"vgOu