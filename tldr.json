ren":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"there is no value in having a string library that needs importing and a ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"k8OiOTfY5h"},{"type":"inlineCode","value":"stringsplit","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zK4OvJ5zOG"},{"type":"text","value":" function. In fact, avoid naming things if you can, and if you must, only name things so close to their use that the definition can be seen without scrolling.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Yj275d5AAJ"}],"key":"jy7Vxva8k6"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"It’s kind of the polar opposite of any DRY rule you will have had drilled into you from the beginning. Good APL code reuses short idioms by “copy & paste” so as not to obscure functionality.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"o5Mg5DcWIZ"}],"key":"h6uL0Vwqos"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Implicit is better than explicit (sometimes)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ollHRasowN"}],"identifier":"implicit-is-better-than-explicit-sometimes","label":"Implicit is better than explicit (sometimes)","html_id":"implicit-is-better-than-explicit-sometimes","implicit":true,"key":"T5hnVxRTGQ"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"If you’re a Python programmer indoctrinated to believe in the Zen of Python ball and chain, you’re probably cringing. In APL, the tacit style allows you to compress more meaning into the glyph count, like, for example the string split example above. This means that short phrases can be made even shorter, and thus become idioms that can be recognized as whole “words”. See Aaron Hsu’s ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"g75FRy4zCd"},{"type":"link","url":"https://github.com/Co-dfns/","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Co-dfns","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"GgrsBJbtrQ"}],"urlSource":"https://github.com/Co-dfns/","error":true,"key":"xewRVorTOh"},{"type":"text","value":" project for an awe-inspiring masterclass in what this can look like when you take this approach to its logical conclusion.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"n3NfTU28Gd"}],"key":"dKkDpB6pXJ"},{"type":"heading","depth":3,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Economy of representation is a virtue","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"lhJ5QjUdSk"}],"identifier":"economy-of-representation-is-a-virtue","label":"Economy of representation is a virtue","html_id":"economy-of-representation-is-a-virtue","implicit":true,"key":"JTSi7mbgke"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"The fewer keystrokes needed for your implementation, the easier it is to discover bugs by inspection, and the more of the system architecture you can hold in your head. This leads to increased confidence when making changes that these will function as intended in the larger context.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"tLO3zLhPPA"}],"key":"kSqhXbJ40Q"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Ken wrote the following:","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"pxnEUaYako"}],"key":"HbbHt6KJut"},{"type":"blockquote","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"The utility of a language as a tool of thought increases with the range of topics it can treat, but decreases with the amount of vocabulary and the complexity of grammatical rules which the user must keep in mind. Economy of notation is therefore important. Economy requires that a large number of ideas be expressible in terms of a relatively small vocabulary. A fundamental scheme for achieving this is the introduction of grammatical rules by which meaningful phrases and sentences can be constructed by combining elements of the vocabulary. --","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"KijWqnWu9s"},{"type":"emphasis","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Ken Iverson","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"hQ4MRvqz2M"}],"key":"P6oe1fHnCE"},{"type":"text","value":" ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"D93wsujsux"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"cite","identifier":"iverson1980notation","label":"iverson1980notation","kind":"parenthetical","position":{"start":{"line":15,"column":563},"end":{"line":15,"column":583}},"children":[{"type":"text","value":"Iverson, 1980","key":"F0uEz1bD5J"}],"enumerator":"3","key":"trptKXMwvl"}],"key":"rfKqpjR5Fc"}],"key":"NCyjQmDPB1"}],"key":"EwgH51n2xP"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Somewhere in the mists of time, that idea was forgotten in mainstream languages. Look at your Java, your C++, your Rust, your Go -- even your Python, a language which prides itself on its clean syntax. Why ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"bEUw1blwMw"},{"type":"emphasis","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"do","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"fGGey2965e"}],"key":"LlRhXg2xLo"},{"type":"text","value":" you have to type all that stuff to get things done?","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"i1HWB2svtj"}],"key":"QO1KoAYDHG"}],"key":"mugppIFugY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Acknowledgements","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PAwObXKQRO"}],"identifier":"acknowledgements","label":"Acknowledgements","html_id":"acknowledgements","implicit":true,"key":"dcF03O8s4y"},{"type":"image","url":"/learnapl/build/aplorchard-f3b05150b88a62598e3a74d16e4345b7.png","alt":"aplorchard","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hfLpksSR8a","urlSource":"./IMG/aplorchard.png","urlOptimized":"/learnapl/build/aplorchard-f3b05150b88a62598e3a74d16e4345b7.webp"},{"type":"div","children":[{"type":"text","value":"[Illustration by ","key":"gGwarBeGxW"},{"type":"link","url":"https://chat.stackexchange.com/users/165520/razetime","children":[{"type":"text","value":"Razetime","key":"HmS6CTgmWO"}],"urlSource":"https://chat.stackexchange.com/users/165520/razetime","key":"cZH0JEDVje"},{"type":"text","value":" on the ","key":"xyPh0vzVWj"},{"type":"link","url":"https://chat.stackexchange.com/transcript/message/55290368#55290368","children":[{"type":"text","value":"APL Orchard","key":"MVrVZEzJYc"}],"urlSource":"https:/